#!/data/data/com.termux/files/usr/bin/bash
# Kumanda'yı ve Claude Code'u günceller. Ayarların ve projelerin silinmez.
set -e
APP="$HOME/.kumanda-uygulama"
BRANCH="$(git -C "$APP" rev-parse --abbrev-ref HEAD)"
git -C "$APP" fetch -q origin "$BRANCH"
git -C "$APP" checkout -q -B "$BRANCH" "origin/$BRANCH"
(cd "$APP/kumanda" && npm install --omit=optional --no-fund --no-audit --loglevel=error)
cp "$APP/kumanda/termux/bin/"* "$PREFIX/bin/"
proot-distro login ubuntu -- /root/.local/bin/claude update || true
echo "Güncellendi. Çalışan 'kumanda' varsa Ctrl+C ile durdurup yeniden başlat."
